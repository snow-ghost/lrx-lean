def table (c : PermCode 5) : List Letter := words[codeIndex c]!

theorem checked : ∀ c : PermCode 5,
    eval (table c) = decode c ∧ (table c).length ≤ Nat.choose 5 2 := by
  decide +kernel

theorem sharp_words : SharpWordBound 5 := words_of_code_certificate table checked

theorem sharp_ediam : (graph 5).ediam ≤ (Nat.choose 5 2 : ℕ∞) :=
  sharp_ediam_of_words sharp_words

