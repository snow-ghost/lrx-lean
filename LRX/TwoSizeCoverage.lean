def twoOuterOfProfile (r : Profile) : OuterRow :=
  (r.parity,r.fixed,r.eps,r.isolated,r.peak,r.exterior)

theorem two_profile_of_outer (r : Profile) (ht : r.t=2) :
    twoProfileOfOuter (twoOuterOfProfile r) r.m r.holes=r := by
  cases r
  simp_all [twoProfileOfOuter,twoOuterOfProfile]

theorem admissible_two_size_bounds (r : Profile) (hr : r.Admissible)
    (hcore : r.CoreBound) (ht : r.t=2)
    (he : r.exterior^2 ≤ 4*r.eps+r.parity+2*(r.E2-r.exterior%2))
    (hm199 : r.m ≤ 199) : r.m ≤ 36 ∧ r.exterior ≤ 7 := by
  have ho := admissible_two_mem_table r hr hcore ht he
  have hm5 := (admissible_two_size_necessary r hr ht).1
  have ha0 := hr.1.2.2.2.2.2.2.2.2.1
  let mm : Fin 200 := ⟨r.m.toNat,by omega⟩
  have hmm : (mm.val : ℤ)=r.m := by dsimp only [mm]; omega
  obtain ⟨cert,hcert⟩ := two_size_coverage (twoOuterOfProfile r) ho mm
  rw [hmm] at hcert
  have hp : (twoProfileOfOuter (twoOuterOfProfile r) r.m r.holes).Admissible := by
    rwa [two_profile_of_outer r ht]
  exact check_two_size_sound (twoOuterOfProfile r) r.m r.holes cert hcert hp

#print axioms two_size_coverage
#print axioms admissible_two_size_bounds
end LRX.FinitePeak
