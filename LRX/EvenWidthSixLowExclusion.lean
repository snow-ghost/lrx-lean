import LRX.FinitePeakProfile

namespace LRX.FinitePeak

def evenSixLowProfile (m u x : ℕ) : Profile :=
  ⟨2,m,0,0,0,0,u,6,x⟩

set_option maxRecDepth 10000
set_option maxHeartbeats 0

private theorem even_six_low_peak_check_m0 : ∀ u : Fin 4, ∀ x : Fin 65,
    let r := evenSixLowProfile 0 u.val x.val
    ¬r.Admissible := by
  decide +kernel

