theorem checked : ∀ c : PermCode 6,
    eval (table c)=decode (n := 8) ((⟨2,by decide⟩ : Fin 8), ((⟨6,by decide⟩ : Fin 7), c)) ∧ (table c).length ≤ Nat.choose 8 2 := by
